{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Voxely",
  "version": "0.1.0",
  "identifier": "com.voxely.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Voxely",
        "width": 880,
        "height": 640,
        "minWidth": 720,
        "minHeight": 480,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; media-src 'self' asset: http://asset.localhost https://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/Voxely/audio/**",
          "$HOME/AppData/Roaming/Voxely/audio/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIwMDRFMjEwMzQxRDhFODUKUldTRmpoMDBFT0lFSVAzeHJJY2xlQXNXOG5CQXd6ZGthSjA4R0hkM0VROGg5MldCNExqaUpHNG4K",
      "endpoints": [
        "https://github.com/AryaPaw/voxely/releases/latest/download/latest.json"
      ]
    }
  }
}
