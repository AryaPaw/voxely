{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:path:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-set-ignore-cursor-events",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "core:webview:allow-internal-toggle-devtools",
    "opener:default",
    "global-shortcut:allow-is-registered",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "global-shortcut:allow-unregister-all",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    "allow-get-session-state",
    "allow-get-settings",
    "allow-save-settings",
    "allow-list-history",
    "allow-get-recording",
    "allow-delete-history-item",
    "allow-delete-all-history",
    "allow-list-microphones",
    "allow-get-meter",
    "allow-api-key-configured",
    "allow-store-api-key",
    "allow-test-openrouter",
    "allow-discover-models",
    "allow-toggle-dictation",
    "allow-retry-recording",
    "allow-open-logs",
    "allow-open-audio-dir",
    "allow-preview-obs-import",
    "allow-import-obs-preset",
    "allow-parse-obs-json",
    "allow-copy-transcript",
    "allow-insert-transcript",
    "allow-run-retention",
    "allow-overlay-timing",
    "allow-preview-dsp",
    "allow-start-filter-sample",
    "allow-stop-filter-sample",
    "allow-check-for-updates",
    "allow-recording-audio-url",
    "allow-cancel-dictation",
    "allow-set-hotkey-capture"
  ]
}
