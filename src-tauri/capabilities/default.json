{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:path:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-set-ignore-cursor-events",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "core:webview:allow-internal-toggle-devtools",
    "opener:default",
    "global-shortcut:allow-is-registered",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "global-shortcut:allow-unregister-all",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    "allow-get-session-state",
    "allow-get-settings",
    "allow-save-settings",
    "allow-list-history",
    "allow-list-history-summaries",
    "allow-get-recording",
    "allow-delete-history-item",
    "allow-delete-all-history",
    "allow-list-microphones",
    "allow-get-meter",
    "allow-start-input-meter",
    "allow-stop-input-meter",
    "allow-api-key-configured",
    "allow-store-api-key",
    "allow-test-openrouter",
    "allow-discover-models",
    "allow-toggle-dictation",
    "allow-retry-recording",
    "allow-open-logs",
    "allow-open-settings-dir",
    "allow-reset-settings",
    "allow-open-audio-dir",
    "allow-copy-transcript",
    "allow-run-retention",
    "allow-overlay-timing",
    "allow-overlay-timeline",
    "allow-overlay-mark-frame",
    "allow-preview-dsp",
    "allow-start-filter-sample",
    "allow-stop-filter-sample",
    "allow-check-for-updates",
    "allow-install-update",
    "allow-show-system-notification",
    "allow-recording-audio-url",
    "allow-cancel-dictation",
    "allow-set-hotkey-capture",
    "allow-open-github",
    "allow-start-model-compare",
    "allow-stop-model-compare",
    "allow-run-model-compare",
    "allow-get-model-compare",
    "allow-clear-model-compare",
    "allow-cancel-model-compare",
    "allow-search-history",
    "allow-get-runtime-info",
    "allow-play-cue",
    "allow-preview-error-notification",
