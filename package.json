{
  "name": "voxely",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write .",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"docs/**/*.md\" README.md package.json vite.config.ts eslint.config.js",
    "version:set": "pwsh -File scripts/set-version.ps1",
    "rebuild:local-app": "pwsh -File scripts/rebuild-local-app.ps1",
    "winget:inspect": "pwsh -File scripts/winget-prepare.ps1 -Mode inspect",
    "winget:test-lib": "pwsh -File scripts/winget-lib.test.ps1",
    "verify": "bun run verify:preflight && bun run verify:frontend && bun run verify:rust:format && bun run verify:rust:lint && bun run verify:rust:tests && bun run verify:rust:coverage && bun run verify:metadata",
    "docs:shots": "vite --config scripts/readme-shots/vite.config.ts",
    "verify:preflight": "bun scripts/check-preflight.ts && bun test ./scripts/check-preflight.bun.ts",
    "verify:frontend": "bun run typecheck && bun run lint && bun run format:check && bun run coverage",
    "verify:rust:format": "cargo fmt --all --check --manifest-path src-tauri/Cargo.toml",
    "verify:rust:lint": "cargo clippy --locked --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "verify:rust:tests": "pwsh -File scripts/check-critical-tests.ps1",
    "verify:rust:coverage": "pwsh -File scripts/check-rust-coverage.ps1",
    "verify:metadata": "pwsh -File scripts/check-version.ps1 && pwsh -File scripts/check-diagnostics.ps1 && pwsh -File scripts/winget-lib.test.ps1 && pwsh -File scripts/check-icons.ps1",
    "hooks:install": "bun scripts/check-preflight.ts --install-hooks"
  },
  "packageManager": "bun@1.4.2",
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-notification": "^2.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.6",
    "lucide-react": "^0.544.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "shadcn": "^4.21.1",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.1",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^4.1.11"
  }
}
