{
  "name": "voxely",
  "private": true,
  "version": "0.5.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "node node_modules/vitest/vitest.mjs run",
    "test:watch": "node node_modules/vitest/vitest.mjs",
    "coverage": "node node_modules/vitest/vitest.mjs run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write .",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"docs/**/*.md\" README.md package.json vite.config.ts eslint.config.js",
    "version:set": "pwsh -File scripts/set-version.ps1",
    "rebuild:local-app": "pwsh -File scripts/rebuild-local-app.ps1",
    "winget:inspect": "pwsh -File scripts/winget-prepare.ps1 -Mode inspect",
    "winget:test-lib": "pwsh -File scripts/winget-lib.test.ps1",
    "verify": "pwsh -NoProfile -File scripts/verify.ps1",
    "verify:checks": "bun run verify:preflight && bun run verify:security && bun run verify:frontend && bun run verify:rust:format && bun run verify:rust:lint && bun run verify:rust:tests && bun run verify:rust:coverage && bun run verify:metadata",
    "docs:shots": "bun scripts/readme-shots/generate.ts",
    "verify:preflight": "bun scripts/check-preflight.ts && bun test ./scripts/check-preflight.bun.ts",
    "verify:security": "bun scripts/check-dependencies.ts",
    "theme:generate": "bun scripts/generate-accent-presets.ts",
    "theme:check": "bun scripts/generate-accent-presets.ts --check",
    "verify:frontend": "bun run --bun theme:check && bun run --bun typecheck && bun run --bun lint && bun run --bun format:check && bun run coverage",
    "verify:rust:format": "cargo fmt --all --check --manifest-path src-tauri/Cargo.toml",
    "verify:rust:lint": "cargo clippy --locked --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "verify:rust:tests": "pwsh -File scripts/check-critical-tests.ps1",
    "verify:rust:coverage": "pwsh -File scripts/check-rust-coverage.ps1",
    "verify:metadata": "pwsh -File scripts/check-version.ps1 && pwsh -NoProfile -File scripts/check-build-date.ps1 && pwsh -File scripts/check-diagnostics.ps1 && pwsh -File scripts/winget-lib.test.ps1 && pwsh -File scripts/release-lib.test.ps1 && pwsh -NoProfile -File scripts/perf/Invoke-VoxelyPerfCampaign.ps1 -SelfTest && pwsh -File scripts/check-icons.ps1 && pwsh -NoProfile -File scripts/rust-build-cache.test.ps1 && pwsh -NoProfile -File scripts/rust-build-cache.native.test.ps1",
    "hooks:install": "bun scripts/check-preflight.ts --install-hooks"
  },
  "packageManager": "bun@1.4.5",
  "engines": {
    "node": "24.22.3"
  },
  "overrides": {
    "minimatch@>=7 <11.0.1": "11.0.1"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-notification": "^2.8.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.77.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "3.11.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.6",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "patchedDependencies": {
    "deepmerge@4.3.1": "patches/deepmerge@4.3.1.patch"
  }
}
